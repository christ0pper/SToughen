# Copy to .env and fill in. .env is gitignored and never leaves your machine.

# Supabase Postgres. In the project: Connect -> ORMs -> Prisma.
# Both hold the database password - ask for them privately, never commit them.
# A password with @ : / ? # or % in it must be percent-encoded (@ becomes %40).
#
# What the app uses - the TRANSACTION pooler, port 6543, with pgbouncer=true.
# Session mode (5432) hands each client its own server connection and holds it,
# and Supabase allows 15 at once: a hosted deployment runs several copies of the
# app and they exhaust the pool between them, locking out everything including
# your laptop. Transaction mode shares connections per statement instead.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# What `prisma db push` uses to create tables - the session pooler, port 5432.
# Schema changes need a session, and they are brief, so the cap above is not a
# problem here. If a `db push` ever hangs, the session pool is full.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs the session cookie. 32+ random characters.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Anyone holding this value can forge a session, so do not reuse the one below.
SESSION_SECRET="change-me-in-production-at-least-32-characters-long"

# --- development only --------------------------------------------------------
# Skips the sign-in screen and treats every visitor as the first Admin.
# Ignored entirely when NODE_ENV=production, and `npm run preflight` fails while
# it is set. Delete this line before pushing or deploying.
# AUTH_DISABLED=true

# Overrides the punch-rounding grace, in minutes. Normally set in the app under
# Settings, which takes precedence over these.
# PAYROLL_LATE_ARRIVAL_GRACE_MINUTES=30
# PAYROLL_EARLY_DEPARTURE_GRACE_MINUTES=30
